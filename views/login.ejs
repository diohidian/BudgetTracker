<nav class="navbar animate__animated animate__lightSpeedInLeft">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">
            <img src="/image/logo.png" alt="Logo" width="30" height="24" class="img-logo d-inline-block align-text-top">
            <span class="fw-bold text-light ">Budget Tracker</span>

        </a>
        <a href="/register" class="btn-register btn liquid">Register</a>
    </div>
</nav>

<div class="form-group-bg d-flex justify-content-center align-items-center animate__animated animate__lightSpeedInLeft"
    style="min-height: calc(100vh - 56px);">
    <div class="card card-login">
        <div class="card-body">
            <div class="text-center mb-4">
                <img src="/image/logo.png" alt="Logo" width="50" height="40" class="mb-2">
                <h4 class="text-light">Budget Tracker</h4>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger" role="alert"><%= error %></div>
            <% } %>
            <form action="/login" method="POST" class="form-group">
                <div class="mb-3">
                    <label for="email" class="form-label text-light">Email address</label>
                    <input type="email" name="email" class="form-control" id="email" aria-describedby="emailHelp">
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label text-light">Password</label>
                    <input type="password" name="password" class="form-control" id="password">
                </div>
                <button type="submit" class="btn liquid">
                    <span>Login</span>
                </button>
            </form>
        </div>
    </div>
</div>
