<!-- this is form for adding transactions -->
<div class="row">
    <div class="ms-5 ps-5 mt-5 form-group-bg d-flex align-items-start animate__animated animate__lightSpeedInLeft row">
        <div class="card card-login p-4 col-md-4 card card h-100">
            <form style="width: 300px;" id="saveTransaction">
                <h4 class="text-center mb-4 cl-text-save">Add Transaction</h4>
                <hr class="cl-text-save">
                <div class="mb-3 d-flex align-items-center ">
                    <label for="..." class="form-label cl-text-save" style="min-width: 120px;">Amount</label>
                    <input type="number" class="form-control" id="amount" name="amount" aria-describedby="..."
                        placeholder="Enter amount">
                </div>
                <div class="mb-3 d-flex align-items-center">
                    <label for="exampleInputPassword1" class="form-label cl-text-save"
                        style="min-width: 120px;">Category</label>
                    <select type="text" class="form-select" id="category" name="category">
                        <option value="">Select</option>
                        <option value="Food and Dining">Food and Dining</option>
                        <option value="Salary">Salary</option>
                        <option value="Transport">Transport</option>
                        <option value="Entertainment">Entertainment</option>
                    </select>
                </div>
                <div class="mb-3 d-flex align-items-center">
                    <label for="type" class="form-label cl-text-save" style="min-width: 120px;">Type</label>
                    <select type="type" class="form-select" id="type" name="type">
                        <option value="">Select</option>
                        <option value="Expense">Expenses</option>
                        <option value="Income">Income</option>
                    </select>
                </div>
                <div class="mb-3 d-flex align-items-center">
                    <label for="datepicker" class="form-label cl-text-save" style="min-width: 120px;">Date</label>
                    <input type="date" class="form-control" id="datepicker" placeholder="Select date" name="date">
                </div>
                <button type="submit" class="btn btn-primary w-100 liquid">Submit</button>
            </form>
        </div>


        <%# ni section untuk menampilkan data transaksi yang sudah disimpan %>
            <div class="card card-login p-4 ms-5 animate__animated animate__lightSpeedInRight col-md-7 transaksi-list "
                style="max-height: 285px; overflow-y: auto;">
                <h4 class="text-center mb-2 cl-text-save">Transaction History</h4>
                <hr class="cl-text-save">
                <ul class="list-group">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="row w-100">
                            <h6 class="mb-0 col-md-3">Description</h6>
                            <h6 class="mb-0 col-md-3">Type</h6>
                            <h6 class="mb-0 col-md-3">Amount</h6>
                            <h6 class="mb-0 col-md-3">Date</h6>
                        </div>
                    </li>
                </ul>

                <!-- Transaction items -->
                <% transaction.forEach(t=> { %>
                    <div class=" animate__animated animate__lightSpeedInRight">
                        <ul class="list-group">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="row w-100">
                                    <h6 class="mb-0 col-md-3">
                                        <%= t.category %>
                                    </h6>
                                    <h6 class="mb-0 col-md-3">
                                        <%= t.type %>
                                    </h6>
                                    <h6
                                        class="mb-0 col-md-3 <%= t.type.toLowerCase() === 'expense' ? 'text-danger' : 'text-success' %>">
                                        <%= t.amount %>
                                    </h6>
                                    <h6 class="mb-0 col-md-3">
                                        <%= t.date %>
                                    </h6>

                                </div>

                                <button class="btn-edit" data-id="<%= t.id %>">Edit</button>

                            </li>
                        </ul>

                    </div>
                    <% }) %>

            </div>
    </div>
</div>

<!-- this is a chart doughnut -->

<div class="container-fluid px-5 mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card card-login grid-overview p-4 animate__animated animate__lightSpeedInRight">
                <h4 class="mb-2 cl-text-save">Overview & Analysis</h4>
                <hr class="cl-text-save">
                <div class="row g-3">
                    <div class="card card-login ms-5 ps-5  col-md-4 bg-chart" style="height: 300px;">
                        <canvas id="spendingChart"></canvas>
                    </div>
                    <div class="card card-login  p-4 ms-5 animate__animated animate__lightSpeedInRight col-md-7 bg-chart"
                        style="height: 300px;">
                        <canvas id="spendingChartLong"></canvas>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

