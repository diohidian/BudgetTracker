<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
</head>

<body>

    <nav class="navbar animate__animated animate__lightSpeedInLeft">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">
                <img src="/image/logo.png" alt="Logo" width="30" height="24"
                    class="img-logo d-inline-block align-text-top">
                <span class="fw-bold text-light ">Budget Tracker</span>

            </a>
            <a href="/" class="btn-register btn liquid">Login</a>
        </div>
    </nav>



    <div class="form-group-bg d-flex justify-content-center align-items-center animate__animated animate__lightSpeedInLeft"
        style="min-height: calc(100vh - 56px);">
        <div class="card card-login">
            <div class="card-body">
                <div class="text-center mb-4">
                    <img src="/image/logo.png" alt="Logo" width="50" height="40" class="mb-2">
                    <h4 class="text-light">Budget Tracker</h4>
                </div>
                <form class="form-group">
                    <div class="mb-3">
                        <label for="exampleInputPassword1" class="form-label text-light">Full Name</label>
                        <input type="text" class="form-control" id="exampleInputPassword1">
                    </div>
                    <div class="mb-3">
                        <label for="exampleInputEmail1" class="form-label text-light">Email address</label>
                        <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp">
                        <div id="emailHelp" class="form-text text-light">Please enter your email address.</div>
                    </div>
                    <div class="mb-3">
                        <label for="exampleInputPassword1" class="form-label text-light">Password</label>
                        <input type="password" class="form-control" id="exampleInputPassword1">
                    </div>
                    <div class="mb-3 form-check">
                    </div>
                    <button class="btn liquid">
                        <span>Register</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>

</html>